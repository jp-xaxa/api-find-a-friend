{
  "name": "api-find-a-friend",
  "version": "1.0.0",
  "description": "Api para sistema Web de doação de pet.",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^22.16.0 || >=24"
  },
  "scripts": {
    "start:dev": "tsx watch src/server.ts",
    "start": "node build/server.js",
    "build": "tsup src --out-dir build --format esm --clean",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "fastify": "^5.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.2.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "prisma": "7.9.1",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
