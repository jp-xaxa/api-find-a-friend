generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Age {
  Filhote
  Adulto
  Idoso
}

enum AnimalSize {
  Pequeno
  Medio
  Grande
}

enum EnergyLevel {
  MUITO_BAIXA @map("Muito Baixa")
  BAIXA       @map("Baixa")
  MEDIA       @map("Média")
  ALTA        @map("Alta")
  MUITO_ALTA  @map("Muito Alta")
}

enum LevelOfIndependence {
  Baixa
  Media
  Alta
}

enum Environment {
  Pequeno
  Medio
  Grande
}

model Ong {
  id                        String   @id @default(uuid())
  name_responsavel          String
  email                     String   @unique
  cep                       String
  address                   String
  phone                     String
  password_hash             String
  created_at                DateTime @default(now())

  pets Pet[]

  @@map("ongs")
}

model Pet {
  id                        String   @id @default(uuid())
  name                      String
  about                     String
  age                       Age
  size                      AnimalSize
  energy_Level              EnergyLevel
  level_independence        LevelOfIndependence
  environment               Environment
  donation_requirements     String[]
  created_at                DateTime @default(now())

  ong_id String
  ong                       Ong @relation(fields: [ong_id], references: [id])

  @@map("pets")
}

